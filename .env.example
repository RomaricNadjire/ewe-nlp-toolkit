# Copier ce fichier en .env puis remplir avec vos identifiants (Hugging Face, Weights & Biases).
# .env est ignoré par git (voir .gitignore) — NE JAMAIS le versionner.
# Tokens Hugging Face : https://huggingface.co/settings/tokens

# Token d'écriture (upload de datasets / modèles : push_to_hub.py, push.sh)
HF_TOKEN_WRITE="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Token de lecture (chargement de dépôts privés)
HF_TOKEN_READ="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# (Optionnel) Clé Weights & Biases — suivi d'entraînement en ligne (ASR/NLLB).
# Sans elle, l'entraînement bascule sur TensorBoard local. Clé : https://wandb.ai/authorize
WANDB_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
